# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL
APP_URL=https://your-production-domain.example
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Application security and production behavior
ANALIZA_LOCAL_AUTH_SECRET=
ANALIZA_DISABLE_DEMO_ADMIN=true
ANALIZA_ENABLE_DEMO_ADMIN=false
ANALIZA_MONTHLY_EVIDENCE_BUCKET=monthly-evidence

# Optional email integration, used only by server routes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional server-only AI integration
OPENAI_API_KEY=
ANALIA_OPENAI_MODEL=
